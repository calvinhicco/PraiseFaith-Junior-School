rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Web mirror + parent portal read-only access (same pattern as other schools).
    // Staff login is enforced by the Next.js app (cookie), not Firebase Auth.
    // Desktop sync uses Admin SDK and bypasses these rules entirely.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
